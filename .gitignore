# ---------------------------------------------------------------------------
# Personal data. Nothing under these paths is ever committed: the repository
# is a template, and every user's profile, documents and packets stay local.
# tools/security_guards.py enforces that these rules are still here.
# ---------------------------------------------------------------------------

# Your source documents (CV, statements, papers, letters, transcripts, postings)
documents/cv/**
documents/statements/**
documents/papers/**
documents/references/**
documents/diplomas/**
documents/teaching/**
documents/postings/**
!documents/**/.gitkeep

# Application packets: they name the departments you applied to, quote what you
# submitted, and record what went wrong.
applications/**
!applications/.gitkeep

# The tracker names every search you are in.
job_search_tracker.csv

# Scrape state. The job-scraper skill resolves `job_scraper/` relative to its
# own directory, so a rooted pattern would miss
# .claude/skills/job-scraper/job_scraper/seen_jobs.json.
**/job_scraper/seen_jobs.json
!job_scraper/.gitkeep

# The build brief for this repository, kept locally.
ai-academic-job-search-prompt.md

# ---------------------------------------------------------------------------
# Build artifacts and machine noise
# ---------------------------------------------------------------------------
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

__pycache__/
*.pyc
.venv/
venv/

.env
.env.*

.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code session files
.claude/projects/
skills-lock.json
